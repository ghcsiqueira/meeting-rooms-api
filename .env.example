# Copie para ".env" para customizar (opcional em desenvolvimento)
PORT=3000
# OBRIGATÓRIO em produção (NODE_ENV=production). Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# Admin criado automaticamente na primeira execução
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123
# Domínio de e-mail permitido no auto-cadastro (POST /auth/register)
COMPANY_EMAIL_DOMAIN=empresadorafa.com
# Caminho do banco SQLite
DB_PATH=./data/rooms.db
